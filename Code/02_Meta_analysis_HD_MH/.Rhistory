install.packages("meta")
# Datos
study <- c("Depression Income Adjusted", "Depression Income Unadjusted", "Depression Overall",
"Anxiety Income Adjusted", "Anxiety Income Unadjusted", "Anxiety Overall",
"Stress Income Adjusted", "Stress Income Unadjusted", "Stress Overall")
n <- c(154049, 323033, 473236, 126582, 23484, 146217, 8994, 18595, 24690)
estimate <- c(-0.27, -0.30, -0.29, -0.17, -0.32, -0.25, -0.25, -0.22, -0.24)
lower_ci <- c(-0.35, -0.39, -0.35, -0.25, -0.48, -0.35, -0.42, -0.35, -0.33)
upper_ci <- c(-0.18, -0.21, -0.23, -0.08, -0.16, -0.16, -0.08, -0.10, -0.14)
# Crear el objeto meta
meta_analysis <- metagen(estimate,
lower = lower_ci,
upper = upper_ci,
studlab = study,
data = NULL,
sm = "SMD",
method.tau = "REML")
# Asegúrate de que el orden de las muestras sea el deseado
meta_analysis$studlab <- factor(meta_analysis$studlab,
levels = c("Depression Income Adjusted",
"Depression Income Unadjusted",
"Depression Overall",
"Anxiety Income Adjusted",
"Anxiety Income Unadjusted",
"Anxiety Overall",
"Stress Income Adjusted",
"Stress Income Unadjusted",
"Stress Overall"))
# Crear el gráfico forest plot con el orden especificado
forest(meta_analysis,
sortvar = estimate,
xlab = "Standardized Mean Difference",
col.diamond = "blue",
col.diamond.lines = "red",
order = order(meta_analysis$studlab))
# Instalar y cargar el paquete necesario
install.packages("meta")
# Crear el objeto meta
meta_analysis <- metagen(estimate,
lower = lower_ci,
upper = upper_ci,
studlab = study,
data = NULL,
sm = "SMD",
method.tau = "REML")
# Asegurarse de que las muestras estén ordenadas según el orden deseado
meta_analysis$studlab <- factor(meta_analysis$studlab,
levels = c("Depression Income Adjusted",
"Depression Income Unadjusted",
"Depression Overall",
"Anxiety Income Adjusted",
"Anxiety Income Unadjusted",
"Anxiety Overall",
"Stress Income Adjusted",
"Stress Income Unadjusted",
"Stress Overall"))
# Crear el gráfico forest plot con el orden especificado
forest(meta_analysis,
sortvar = estimate,
xlab = "Standardized Mean Difference",
col.diamond = "blue",
col.diamond.lines = "red",
order = order(meta_analysis$studlab))  # Asegurarnos de que el orden se respete
